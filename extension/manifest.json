{
  "manifest_version": 3,
  "name": "Personal AI Input Archive",
  "version": "0.11.1",
  "version_name": "v0.11.1 Thought Library Reading Closure",
  "description": "经主动同意后，仅在本机归档 ChatGPT 已显示的用户文字。以连续文档阅读与整理，支持暂停、检索和导出。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Personal AI Input Archive",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core/diagnostics-schema.js",
        "adapter/input-presence.js",
        "adapter/chatgpt-adapter.js",
        "core/json-fingerprint.js",
        "core/history-time.js",
        "core/source-time.js",
        "core/response-time.js",
        "content/response-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "adapter/response-parser.js",
        "adapter/json-fingerprint.js",
        "adapter/history-contract.js",
        "content/response-observer.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'none'; connect-src https://api.deepseek.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}
