        needs: mode
        if: needs.mode.outputs.full == 'true'
        name: Current Browser ${{ matrix.index }}/10
        runs-on: ubuntu-latest
        timeout-minutes: 18
        strategy:
          fail-fast: false
          matrix:
            include:
              - index: 1
                shard: '1/10'
              - index: 2
                shard: '2/10'
              - index: 3
