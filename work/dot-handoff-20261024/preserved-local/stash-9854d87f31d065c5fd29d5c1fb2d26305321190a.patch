+.context-card .card-title{font:500 16.5px/1.5 var(--font);letter-spacing:0;font-synthesis:none}
+.context-card .card-symbol,html[data-paia-theme="dark"] .context-card .card-symbol{width:21px;height:21px;flex:0 0 21px;background:none;border:0;border-radius:0}
+.context-card .card-symbol::before,.context-card .card-symbol::after{content:none}
+.context-card .card-symbol-icon{width:21px;height:21px;stroke-width:1.4}
+.context-card .context-directory-link,.context-card .input-summary{font:400 13.5px/1.65 var(--font)}
+.context-card .context-directory{margin-top:8px;padding-top:0;min-height:0}
+.context-card .card-footer{margin-inline:22px;padding-block:12px}
+.context-detail .context-head h1{font:500 16.5px/1.5 var(--font);letter-spacing:0;font-synthesis:none}
+.context-detail .context-head{margin-bottom:16px;align-items:center}
+.context-detail-right{padding-top:0}
+.context-item-footer{justify-content:flex-end}
+.context-home-end,.context-detail-footer{justify-content:flex-end;gap:12px}
+@media(max-width:767px){
+ .context-page:not(.context-detail) .context-head{gap:12px}
+ .context-head>.context-search{flex-basis:100%;max-width:none;width:100%;margin:0}
+ .context-head .context-access-bar{justify-content:flex-start}
+ .context-head .context-access-controls{justify-content:flex-start;gap:8px}
+ .context-cards{grid-template-columns:minmax(0,1fr)}
+ .context-card .card-title{font-size:16.5px}
+ .context-card .context-directory-link{min-height:44px}
+ .context-back-row{margin-bottom:16px}
+ .context-detail .context-head{gap:12px}
+}
