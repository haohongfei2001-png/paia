      "font_style": "normal",
      "line_height": 53,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "Take the next step",
        "with a little more context."
      ],
      "copy_id": "copy-96ead3b34b0b",
      "role": "text",
      "anchor": "start"
