    },
    {
      "id": "article-context-en-1440.015",
      "kind": "text",
      "paint_order": 15,
      "x": 287,
      "y": 220,
      "width": 905,
      "font_family": "EB Garamond 12",
      "font_size": 64,
      "font_style": "normal",
      "line_height": 69,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "A conversation is a moment.",
        "Context is a practice."
      ],
      "copy_id": "copy-5c0cddb56c9c",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-en-1440.016",
      "kind": "text",
      "paint_order": 16,
      "x": 287,
      "y": 392,
      "width": 784,
      "font_family": "Inter",
      "font_size": 22,
      "font_style": "normal",
      "line_height": 31.9,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "Why keeping your words is only the beginning."
      ],
      "copy_id": "copy-dc7ad7690f03",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-en-1440.017",
      "kind": "text",
      "paint_order": 17,
      "x": 287,
      "y": 466,
      "width": null,
      "font_family": "Inter",
      "font_size": 11,
      "font_style": "normal",
      "line_height": 15.95,
      "letter_spacing": 0,
      "color": "#707975",
      "lines": [
        "PAIA · Editorial draft for publication review"
      ],
      "copy_id": "copy-b6b352df7872",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-en-1440.018",
      "kind": "photograph",
      "paint_order": 18,
      "asset": "coast",
      "x": 287,
      "y": 522,
