      "x1": 76,
      "y1": 2335,
      "x2": 1364,
      "y2": 2335,
      "stroke": "#dfe2dc",
      "stroke_width": 1
    },
    {
      "id": "article-context-en-1440.030",
      "kind": "text",
      "paint_order": 30,
      "x": 76,
      "y": 2383,
      "width": 800,
      "font_family": "EB Garamond 12",
