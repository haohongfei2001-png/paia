      "font_style": "normal",
      "line_height": 18.15,
      "letter_spacing": 0,
      "color": "#707975",
      "lines": [
        "PAIA · 待审阅的文章草稿"
      ],
      "copy_id": "copy-b6b352df7872",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-zh-1440.018",
      "kind": "photograph",
      "paint_order": 18,
      "asset": "coast",
      "x": 287,
      "y": 522,
      "width": 866,
      "height": 389,
      "rotation": -0.6,
