      "lines": [
        "02 / A DESIGN PRINCIPLE"
      ],
      "copy_id": "copy-053adbd47d12",
      "role": "decorative-annotation",
      "anchor": "start"
    },
    {
      "id": "our-story-en-1440.025",
      "kind": "text",
      "paint_order": 25,
      "x": 788,
      "y": 1348,
      "width": 556,
      "font_family": "EB Garamond 12",
      "font_size": 47,
      "font_style": "normal",
      "line_height": 52,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "Yours, before it is",
        "useful to anyone else."
      ],
      "copy_id": "copy-52d672623d1c",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "our-story-en-1440.026",
      "kind": "text",
      "paint_order": 26,
      "x": 788,
      "y": 1482,
      "width": 492,
      "font_family": "Inter",
      "font_size": 17,
      "font_style": "normal",
      "line_height": 24.65,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "Readable for a person and useful to an AI are not competing",
        "goals. A source you can inspect, a working version you can",
        "edit and a selection you can control are the foundations of",
        "both."
      ],
      "copy_id": "copy-447afaaa2e9a",
      "role": "text",
      "anchor": "start"
    },
