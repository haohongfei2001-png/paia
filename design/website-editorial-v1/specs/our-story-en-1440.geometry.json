      "font_style": "normal",
      "line_height": 16,
      "letter_spacing": 2.4,
      "color": "#707975",
      "lines": [
        "01 / A DESIGN PRINCIPLE"
      ],
      "copy_id": "copy-c22e6fac9b28",
      "role": "decorative-annotation",
      "anchor": "start"
    },
    {
      "id": "our-story-en-1440.020",
      "kind": "text",
      "paint_order": 20,
      "x": 76,
      "y": 816,
      "width": 556,
      "font_family": "EB Garamond 12",
      "font_size": 47,
      "font_style": "normal",
      "line_height": 52,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "Not more to maintain.",
        "More to continue."
      ],
      "copy_id": "copy-a47ac8d57fde",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "our-story-en-1440.021",
      "kind": "text",
      "paint_order": 21,
      "x": 76,
      "y": 950,
      "width": 492,
      "font_family": "Inter",
      "font_size": 17,
      "font_style": "normal",
      "line_height": 24.65,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "We are building a personal input, thought and context system",
        "around expressions you already produce. The archive should",
        "be useful before you have organized a single topic."
      ],
      "copy_id": "copy-f2e6662a63c0",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "our-story-en-1440.022",
