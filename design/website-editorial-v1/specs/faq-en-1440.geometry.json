      "font_size": 29,
      "font_style": "normal",
      "line_height": 36,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "How do I get access?"
      ],
      "copy_id": "copy-780bd2633c7d",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "faq-en-1440.058",
      "kind": "text",
