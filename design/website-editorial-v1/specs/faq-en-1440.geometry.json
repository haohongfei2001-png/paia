      "x": 584,
      "y": 2893.6000000000004,
      "width": 725,
      "font_family": "Inter",
      "font_size": 17,
      "font_style": "normal",
      "line_height": 24.65,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
