    },
    {
      "id": "article-context-zh-390.009",
      "kind": "text",
      "paint_order": 9,
      "x": 24,
      "y": 172,
      "width": 337,
      "font_family": "Noto Serif CJK SC",
      "font_size": 43,
      "font_style": "normal",
      "line_height": 48,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "对话是一个时刻",
        "，",
        "语境是一种持续",
        "的工作。"
      ],
      "copy_id": "copy-5c0cddb56c9c",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-zh-390.010",
      "kind": "text",
      "paint_order": 10,
      "x": 24,
      "y": 398,
      "width": 334,
      "font_family": "Noto Sans CJK SC",
      "font_size": 18,
      "font_style": "normal",
      "line_height": 29.7,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "为什么留下原话，只是开始。"
      ],
      "copy_id": "copy-dc7ad7690f03",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-zh-390.011",
      "kind": "text",
      "paint_order": 11,
      "x": 24,
      "y": 472,
      "width": null,
      "font_family": "Noto Sans CJK SC",
      "font_size": 11,
      "font_style": "normal",
      "line_height": 18.15,
      "letter_spacing": 0,
      "color": "#707975",
      "lines": [
        "PAIA · 待审阅的文章草稿"
      ],
      "copy_id": "copy-b6b352df7872",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-context-zh-390.012",
      "kind": "photograph",
      "paint_order": 12,
      "asset": "coast",
      "x": 24,
      "y": 528,
      "width": 342,
      "height": 235,
      "rotation": -0.6,
      "crop_xywh": [
        0.0,
        50.29,
        1600.0,
        1099.42
      ],
      "position": [
        0.5,
        0.5
      ],
