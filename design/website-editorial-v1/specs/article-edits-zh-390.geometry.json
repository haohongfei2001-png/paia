      "line_height": 18.15,
      "letter_spacing": 0,
      "color": "#707975",
      "lines": [
        "PAIA · 待审阅的文章草稿"
      ],
      "copy_id": "copy-b6b352df7872",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-edits-zh-390.012",
      "kind": "photograph",
      "paint_order": 12,
      "asset": "architecture",
      "x": 24,
      "y": 432,
      "width": 342,
      "height": 235,
      "rotation": -0.6,
      "crop_xywh": [
        23.59,
        0.0,
        1552.83,
