      "letter_spacing": 0,
      "color": "#707975",
      "lines": [
        "PAIA · 待审阅的文章草稿"
      ],
      "copy_id": "copy-b6b352df7872",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "article-edits-zh-1440.018",
