      "x": 504,
      "y": 1621,
      "width": 702,
      "font_family": "EB Garamond 12",
      "font_size": 27,
      "font_style": "normal",
      "line_height": 36,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "7. Contact"
      ],
      "copy_id": "copy-96c5f4a027b2",
      "role": "text",
      "anchor": "start"
    },
    {
