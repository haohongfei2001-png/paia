      "line_height": 42,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "An intention,",
        "not an inflated promise."
      ],
      "copy_id": "copy-d6fd07b85332",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "our-story-en-390.021",
