      "width": 331,
      "font_family": "Inter",
      "font_size": 16,
      "font_style": "normal",
      "line_height": 23.2,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "PAIA is independently developed and in",
        "private beta. Some ambitions are further",
        "away than the current build. We separate",
        "what is available, what remains under",
        "development and what still needs",
        "real-world evidence."
      ],
      "copy_id": "copy-bfbb59e8409e",
