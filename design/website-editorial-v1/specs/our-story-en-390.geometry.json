    {
      "id": "our-story-en-390.016",
      "kind": "text",
      "paint_order": 16,
      "x": 24,
      "y": 1098.6,
      "width": 337,
      "font_family": "EB Garamond 12",
      "font_size": 36,
      "font_style": "normal",
      "line_height": 42,
      "letter_spacing": 0,
      "color": "#171c19",
      "lines": [
        "Yours, before it is",
        "useful to anyone else."
      ],
      "copy_id": "copy-52d672623d1c",
      "role": "text",
      "anchor": "start"
    },
    {
      "id": "our-story-en-390.017",
      "kind": "text",
      "paint_order": 17,
      "x": 24,
      "y": 1208.6,
      "width": 331,
      "font_family": "Inter",
      "font_size": 16,
      "font_style": "normal",
      "line_height": 23.2,
      "letter_spacing": 0,
      "color": "#616969",
      "lines": [
        "Readable for a person and useful to an AI",
        "are not competing goals. A source you can",
        "inspect, a working version you can edit and",
        "a selection you can control are the",
        "foundations of both."
      ],
      "copy_id": "copy-447afaaa2e9a",
      "role": "text",
      "anchor": "start"
    },
