    },
    "api/provider.mjs": {
      "maxDuration": 60,
      "includeFiles": "../../extension/{package.json,core/constants.js,core/dedupe.js,core/ai-usage/{admission-policy,atomic-reservation,budget-window-policy,budget-window-reservation,client-declaration,client-declaration-transport,client-gateway-http,client-provider-transport,client-reservation-transport,contracts,qwen-json-decoder,qwen-qualified-request,qwen-request-data,qwen-request-profile,qwen-sse-decoder,qwen-usage-parser,qwen-wire-primitives,ratebook,result-finalization,usage-normalization}.js}"
