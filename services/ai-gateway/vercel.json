    },
    "api/operation-status.mjs": {
      "maxDuration": 60,
      "includeFiles": "../../extension/{package.json,core/constants.js,core/dedupe.js,core/ai-usage/{admission-policy,atomic-reservation,budget-window-policy,budget-window-reservation,contracts,ratebook,result-finalization,usage-normalization}.js}"
    }
  }
